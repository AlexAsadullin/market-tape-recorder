# Shared platform data root; this project writes only under $TRADEQ_DATA_DIR/market-tape-recorder/.
TRADEQ_DATA_DIR=/absolute/path/to/Tradeq/data
# Label of this capture host, written into every row (capture_region).
TAPE_REGION=eu-local
# T-Bank Invest API token (free; read-only market data is enough). Without it moex-tbank is skipped.
# TBANK_TOKEN=
# MOEX AlgoPack token (paid). Without it moex-algopack is skipped.
# ALGOPACK_TOKEN=
# Optional: alternative settings file.
# TAPE_CONFIG_FILE=/absolute/path/to/settings.yaml
